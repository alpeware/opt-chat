{
  "optchat-memory-bridge": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "/home/simonpure/.local/bin/optchat hook pre-invocation",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/simonpure/.local/bin/optchat hook post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "/home/simonpure/.local/bin/optchat hook post-invocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "/home/simonpure/.local/bin/optchat hook stop",
        "timeout": 5
      }
    ]
  }
}